# Runtime database connection (Supabase: Transaction pooler URI, port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Migrations + seed only (Supabase: Session pooler URI, port 5432). Local Postgres: same as DATABASE_URL.
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Signs the session cookie. Any random string of 32+ characters.
SESSION_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# Optional
CRON_SECRET=
